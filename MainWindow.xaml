<Window x:Class="GlyphCraft.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:GlyphCraft.Controls"
        Title="GlyphCraft" Width="1200" Height="820" MinWidth="960" MinHeight="680"
        Background="White" FontFamily="{StaticResource Brand}" Foreground="{StaticResource Ink}"
        AllowDrop="True" Drop="Window_Drop" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Navy}">
            <DockPanel Margin="16,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource HeaderButton}" Content="Open font…" Click="OpenFont_Click"/>
                    <Button Style="{StaticResource HeaderButton}" Content="Open folder…" Click="OpenFolder_Click"/>
                    <Button x:Name="FullBtn" Style="{StaticResource HeaderButton}" Content="Full font preview" Click="Full_Click"/>
                    <Button Style="{StaticResource HeaderButton}" Content="About" Margin="0" Click="About_Click"/>
                </StackPanel>
                <Image Source="/Assets/logo.png" Width="46" Height="46" DockPanel.Dock="Left" Margin="0,0,12,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GlyphCraft" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Character Map, turbo-charged" Foreground="#A9C4DE" FontSize="11"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Font list -->
            <Border Grid.Column="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="FONTS" Margin="14,14,14,6" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource Accent}"/>
                    <TextBox x:Name="FilterBox" Grid.Row="1" Margin="12,0,12,8" Padding="6,5" FontSize="12"
                             ToolTip="Type to filter the font list" TextChanged="FilterBox_TextChanged"/>
                    <ListBox x:Name="FontList" Grid.Row="2" BorderThickness="0" SelectionChanged="FontList_SelectionChanged"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="{StaticResource Accent}" CornerRadius="2"
                                            Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding BadgeVisibility}">
                                        <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="3" Margin="14,8" FontSize="10" TextWrapping="Wrap" Foreground="#6B849A"
                               Text="Drop font files or folders anywhere in this window — TTF, OTF, TTC, WOFF, WOFF2 and EOT."/>
                </Grid>
            </Border>

            <!-- Main area -->
            <Grid Grid.Column="1" Margin="16,12,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="270"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                    <TextBlock Text="Style" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                    <ComboBox x:Name="StyleBox" Width="150" Margin="0,0,16,0" DisplayMemberPath="Style"
                              SelectionChanged="StyleBox_SelectionChanged"/>
                    <TextBlock Text="Show" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                    <ComboBox x:Name="BlockBox" Width="230" Margin="0,0,16,0" DisplayMemberPath="Label"
                              SelectionChanged="BlockBox_SelectionChanged"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BrandButton}" Content="Find" Margin="6,0,0,0"
                            Click="Find_Click"/>
                    <TextBox x:Name="FindBox" DockPanel.Dock="Right" Width="170" Padding="6,4" FontSize="12" VerticalContentAlignment="Center"
                             ToolTip="A character, a decimal code (8364) or hex (U+20AC)" KeyDown="FindBox_KeyDown"/>
                    <TextBlock DockPanel.Dock="Right" Text="Find" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                </DockPanel>

                <!-- Preview + info -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="290"/>
                    </Grid.ColumnDefinitions>
                    <c:GlyphPreview x:Name="Preview" Grid.Column="0" Margin="0,0,12,0"
                                    ToolTip="Right-click for Copy, Save as EPS and Save as SVG"/>
                    <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="White" Padding="16,12">
                        <StackPanel>
                            <TextBlock x:Name="InfoCode" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Navy}" Text="U+0041"/>
                            <TextBlock x:Name="InfoBlock" FontSize="11" Foreground="{StaticResource Accent}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBlock x:Name="InfoDetail" FontSize="12" LineHeight="19" Margin="0,0,0,12"/>
                            <Border Background="{StaticResource Tint}" CornerRadius="3" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Text="TYPE WITH ALT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                    <TextBlock x:Name="InfoKeys" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Navy}" Margin="0,2,0,2"/>
                                    <TextBlock x:Name="InfoKeyHint" FontSize="10" TextWrapping="Wrap" Foreground="#4B627A"/>
                                </StackPanel>
                            </Border>
                            <CheckBox x:Name="GuidesCheck" Content="Show guides" IsChecked="True" Margin="0,12,0,0" FontSize="12"
                                      Checked="Guides_Changed" Unchecked="Guides_Changed"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Grid -->
                <Border Grid.Row="2" Margin="0,12,0,0" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <c:GlyphGrid x:Name="GlyphGridView" Grid.Column="0"/>
                        <ScrollBar x:Name="GridBar" Grid.Column="1" Orientation="Vertical"/>
                    </Grid>
                </Border>

                <!-- Full font preview overlay -->
                <Border x:Name="FullPanel" Grid.Row="1" Grid.RowSpan="2" Background="White" Visibility="Collapsed"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="18,12,18,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Size" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                <Slider x:Name="FullSize" Width="180" Minimum="24" Maximum="120" Value="56"
                                        ValueChanged="FullSize_Changed" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="FullTitle" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Navy}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,0,18,16">
                            <StackPanel>
                                <TextBlock Text="UPPERCASE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,8,0,2"/>
                                <c:GlyphTextView x:Name="FpUpper"/>
                                <TextBlock Text="LOWERCASE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,12,0,2"/>
                                <c:GlyphTextView x:Name="FpLower"/>
                                <TextBlock Text="NUMERALS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,12,0,2"/>
                                <c:GlyphTextView x:Name="FpNumbers"/>
                                <TextBlock Text="PUNCTUATION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,12,0,2"/>
                                <c:GlyphTextView x:Name="FpPunct"/>
                                <TextBlock Text="EXTENDED PUNCTUATION AND SYMBOLS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,12,0,2"/>
                                <c:GlyphTextView x:Name="FpExtra"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Characters to copy -->
                <DockPanel Grid.Row="3" Margin="0,12,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BrandButton}" Content="Clear" Margin="8,0,0,0" Click="ClearCopy_Click"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BrandButton}" Content="Copy" Margin="8,0,0,0" Click="CopyText_Click"/>
                    <TextBlock DockPanel.Dock="Left" Text="Characters to copy" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"/>
                    <TextBox x:Name="CopyBox" Padding="6,5" FontSize="16" VerticalContentAlignment="Center"
                             ToolTip="Double-click a glyph (or press Enter on it) to add it here"/>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="2" Background="{StaticResource Tint}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="16,0" FontSize="11" Foreground="#4B627A"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
