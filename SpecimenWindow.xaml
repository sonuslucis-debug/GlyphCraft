<Window x:Class="GlyphCraft.SpecimenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Font specimen" Width="940" Height="900" MinWidth="640" MinHeight="520"
        Icon="/Assets/logo.png"
        WindowStartupLocation="CenterOwner" Background="#E8EEF5"
        FontFamily="{StaticResource Brand}" Foreground="{StaticResource Ink}"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Navy}">
            <DockPanel Margin="16,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource HeaderButton}" Content="Print…" Click="Print_Click"/>
                    <Button Style="{StaticResource HeaderButton}" Content="Close" Margin="0" Click="Close_Click"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Font specimen" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="Subtitle" Foreground="#A9C4DE" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <DocumentViewer x:Name="Viewer" Grid.Row="1" Margin="10" Background="#E8EEF5"
                        HorizontalContentAlignment="Center"/>
    </Grid>
</Window>
