<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>GlyphCraft</AssemblyName>
    <RootNamespace>GlyphCraft</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Product>GlyphCraft</Product>
    <Company>Sonus Lucis</Company>
    <Copyright>(c) 2026 Sonus Lucis</Copyright>
    <Version>1.0.3</Version>
    <AssemblyVersion>1.0.3.0</AssemblyVersion>
    <FileVersion>1.0.3.0</FileVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- All source files live in the repo root; ignore any stale copies left in old sub-folders -->
    <Compile Remove="Core\**;Controls\**;Services\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

</Project>
